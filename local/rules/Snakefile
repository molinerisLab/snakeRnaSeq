###############
#   Ruleorder   #
###############

if config["LAYOUT"] == "SINGLE":

    ruleorder: fastp_se > fastp_pe
    ruleorder: trim_galore_se > trim_galore_pe
    ruleorder: star_align_se > star_align_pe

elif config["LAYOUT"] == "PAIRED":

    ruleorder: fastp_pe > fastp_se
    ruleorder: trim_galore_pe > trim_galore_se
    ruleorder: star_align_pe > star_align_se


ruleorder: featurecounts > split_bam_ribo


##############
# Rules ALL  #
##############


rule all:
    input:
        "GEP.count.exp_filter.ltmm.gz.xlsx",
        "multiqc_report.html",
        "multiqc_report.rseqc.html",
        "usable_reads.txt.xlsx",


rule all_isoform:
    input:
        # Kallisto Outputs
        "transcripts_tpm.tsv",  # The merged output
        # StringTie Outputs
        "stringtie/merged/merged.gtf",  # The merged assembly
        expand("stringtie/{sample}/quant/abund.tab", sample=SAMPLES),
        "stringtie/gene_count_matrix.csv",  # (See point 3 below)
        # Spladder Outputs
        "spladder/quantification/spladder/genes_graph_conf3.quant.pickle",


rule all_majiq:
    input:
        expand("Majiq/Results/tsv/{sample}_cohort.tsv", sample=SAMPLES),


rule all_multiqc:
    input:
        "multiqc_report.html",
        "multiqc_report.rseqc.html",
        "multiqc_report.alignment.html",


rule all_fastq_trimmed:
    input:
        expand("fastq/fastq_trimmed/{sample}_R1.fastq.gz", sample=SAMPLES),


rule ALL_infer_experiment:
    input:
        expand("rseqc/{samples}.infer_experiment.txt", samples=SAMPLES),
    output:
        "ALL_infer_experiment",
    shell:
        r"""  
        matrix_reduce 'rseqc/*.infer_experiment.txt' -l '{input}' | grep . | perl -lne 'if(m/^>/){{print; next}} print "$1\t$2" if m/("[^:]+|failed to determine):\s+(.*)/' | fasta2tab | tab2matrix -r sample > {output}
    """


rule ALL_star:
    input:
        expand("Results/star/{sample}/Aligned.sortedByCoord.out.bam", sample=SAMPLES),
        

rule all_fastq_unmapped:
    input:
        expand("fastq_unmapped/{sample}_R1.fastq.gz", sample=SAMPLES),
        expand("fastq_unmapped/{sample}_R2.fastq.gz", sample=SAMPLES),


rule all_star_sp:
    input:
        expand(
            "Results/pass2/{sample}/{suffix}",
            genome=[config["GENCODE"]["VERSION"]],
            sample=SAMPLES,
            suffix=["Aligned.sortedByCoord.out.bam", "ReadsPerGene.out.tab"],
        ),


