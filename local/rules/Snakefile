# -------------- #
# Multiqc report #
# -------------- #
rule fastqc:
	input:
		"{sample}.fastq.gz"
	output:
		fastqc_html="{sample}_fastqc.html",
		fastqc_zip="{sample}_fastqc.zip"
	params:
		fastqc_threads=config["CORES"]
	shell:
		"fastqc -t {params.fastqc_threads} -o `dirname {input}` {input}"

rule multiqc_fastq:
    input:
        fastqc_html=expand("fastq/{fastq}_fastqc.html", fastq=FASTQ_FILES),
        fastqc_zip=expand("fastq/{fastq}_fastqc.zip", fastq=FASTQ_FILES)
    output:
        "fastq/multiqc_report.html"
    shell:
        "{CONDA_ACTIVATE} multiqc_v1.19; "
        "multiqc -f -n {output} fastq"

rule multiqc_alignment:
    input:
        fastqc_html=expand("fastq/{fastq}_fastqc.html", fastq=FASTQ_FILES),
        fastqc_zip=expand("fastq/{fastq}_fastqc.zip", fastq=FASTQ_FILES),
        bam=expand("bam/{sample}.bam", sample=FASTQ_SAMPLES),
        bai=expand("bam/{sample}.bam.bai", sample=FASTQ_SAMPLES)
    output:
        report="multiqc_report.alignment.html",
        star="multiqc_report.alignment_data/multiqc_star.txt"
    shell:
        "multiqc -f -n {output} ."

# ----- #
# RSeQC #
# ----- #
rule gene_body_coverage:
    input:
        bam="star/{sample}/Aligned.sortedByCoord.out.bam",
        bai="star/{sample}/Aligned.sortedByCoord.out.bam.bai",
        housekeeping_genes=GENCODE_DIR+"/rseqc.HouseKeepingGenes.bed.gz"
    output:
        text="rseqc/{sample}.geneBodyCoverage.txt",
        rscript="rseqc/{sample}.geneBodyCoverage.r"
    params:
        docker_data_dir=config["DOCKER_DATA_DIR"],
        scratch_dir=config["TMPDIR"]
    shell:
        "mkdir -p `dirname {output.text}`; "
        "docker run -u `id -u`:`id -g` --rm "
        "-v {params.docker_data_dir}:{params.docker_data_dir} "
        "-v {params.scratch_dir}:{params.scratch_dir} "
        "quay.io/biocontainers/rseqc:4.0.0--py38h0213d0e_0  "
        "bash -c \"cd `echo $PWD`; "
        "geneBody_coverage.py -i {input.bam} -r <(zcat {input.housekeeping_genes}) -o rseqc/{wildcards.sample}\"; "
        "sed -i 's|Aligned.sortedByCoord.out|{wildcards.sample}|' {output.text}"

rule plot_gene_body_coverage_summary:
    input:
        all_gene_body_cov=expand(
            "rseqc/{sample}.geneBodyCoverage.txt",
            sample=FASTQ_SAMPLES
        ),
        rscript="../../local/src/plotGeneBodyCovSummary.R"
    output:
        plt_all="rseqc/geneBodyCoverage.all.pdf",
        plt_summary="rseqc/geneBodyCoverage.summary.pdf"
    shell:
        "{CONDA_ACTIVATE} rstudio_Rv4.0.3; "
        "Rscript --vanilla {input.rscript} rseqc"

rule read_distribution:
    input:
        bam="star/{sample}/Aligned.sortedByCoord.out.bam",
        rseqc_ref_bed=GENCODE_ANNOTATION_BED
    output:
        text="rseqc/{sample}.read_distribution.txt"
    params:
        docker_data_dir=config["DOCKER_DATA_DIR"],
        scratch_dir=config["TMPDIR"]
    shell:
        "mkdir -p `dirname {output}`; "
        "docker run -u `id -u`:`id -g` --rm "
        "-v {params.docker_data_dir}:{params.docker_data_dir} "
        "-v {params.scratch_dir}:{params.scratch_dir} "
        "quay.io/biocontainers/rseqc:4.0.0--py38h0213d0e_0  "
        "bash -c \"cd `echo $PWD`; "
        "read_distribution.py -i {input.bam} -r {input.rseqc_ref_bed} > {output.text}\" "

rule plot_read_distribution:
    input:
        all_gene_body_cov=expand(
            "rseqc/{sample}.read_distribution.txt",
            sample=FASTQ_SAMPLES
        ),
        rscript="../../local/src/plotReadDistributionSummary.R"
    output:
        "rseqc/reads_distribution_summary.pdf",
    shell:
        "{CONDA_ACTIVATE} rstudio_Rv4.0.3; "
        "Rscript --vanilla {input.rscript} rseqc"


