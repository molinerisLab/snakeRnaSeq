#original fastq files were renames with rename 's/_001(?=\.fastq\.gz)//' *.fastq.gz 

rule correct_fastq_names:
    input: "{file}_001.fastq.gz"
    output: "{file}.fastq.gz"
    shell: "echo 'run rename -n 's/_S\d+//' *.fastq.gz and rename 's/_001(?=\.fastq\.gz)//' *.fastq.gz inside fastq/'"

rule filter_exp:
    input:
        "GEP.count.exp_filter.ltmm.gz"
    output:
        "GEP.count.exp_filter.ltmm.no_undeter.gz"
    shell:
        "zless {input} | bawk '{{print $1~13}}' | gzip > {output}"

rule filter_metadata:
    input:
        "metadata.txt"
    output:
        "metadata.no_undeter.txt"
    shell:
        "cat {input} | grep -v 'Undetermined' > {output}"

rule merge_selected_bam:
    input:
        expand("star/{sample}.selected.bam", sample=SAMPLES)
    output:
        "star/ALL_samples.selected.bam"
    shell:"""
        samtools merge {output}.tmp {input};
        samtools sort -o {output} {output}.tmp;
        rm {output}.tmp
    """

rule select_regions:
    input:
        "star/{path}.bam"
    output:
        temp("star/{path}.selected.bam")
    shell:"""
        samtools view -h -b {input} chr7:5,527,148-5,530,601 chr12:6,534,517-6,538,371 chr19:54,115,754-54,131,713 > {output}
    """


