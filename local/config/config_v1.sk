############
# Samples  #
############

import glob
import re
import os

RAW_DATA_DIR = "fastq/"
EXCLUDE_DIRS = ['fastq_trimmed', 'unmapped', 'unclassified', 'ribo.ex']
files = glob.glob(os.path.join(RAW_DATA_DIR, "*.fastq.gz"))

SAMPLES = set()

for filepath in files:
    filename = os.path.basename(filepath)
    
    if any(d in filepath for d in EXCLUDE_DIRS):
        continue
    match = re.search(r'(.+)_R[12](?:_.+)?\.fastq\.gz', filename)

    if match:
        SAMPLES.add(match.group(1))

SAMPLES = sorted(list(SAMPLES))

print("Detected samples:", SAMPLES)

###################
# Reference root  #
###################

REFERENCE_ROOT = os.environ.get("REFERENCE_ROOT") or config.get("REFERENCE_ROOT", "")
if not REFERENCE_ROOT:
    raise WorkflowError(
        "\n[preflight] REFERENCE_ROOT is not set. Either:\n"
        "  • export REFERENCE_ROOT=/path/to/references  (shell / .envrc)\n"
        "  • add 'REFERENCE_ROOT: /path/to/references'  (config.yaml)"
    )
