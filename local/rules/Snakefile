###########
# Import  #
###########

import os

###########
# Config  #
###########

configfile: "config.yaml"

############
# Samples  #
############

SAMPLES, = glob_wildcards("fastq/{sample}_R1.fastq.gz")
print("Detected samples:", SAMPLES)
RAW_DATA_DIR = "fastq/"

###################
# Reference root  #
###################

REFERENCE_ROOT=os.environ.get("REFERENCE_ROOT")

#############
# Genecode  #
#############

GENCODE_DIR=REFERENCE_ROOT+"/bioinfotree/task/gencode/dataset/"+config["GENCODE"]["SPECIES"]+"/"+config["GENCODE"]["VERSION"]
GENCODE_GENOME_FASTA=GENCODE_DIR+"/"+config["GENCODE"]["GENOME"]+".genome.fa"
GENCODE_ANNOTATION_GTF=GENCODE_DIR+"/"+config["GENCODE"]["ANNOTATION"]+".gtf"
GENCODE_ANNOTATION_BED=GENCODE_DIR+"/"+config["GENCODE"]["ANNOTATION"]+".bed"
RSEQC_REF_BED=GENCODE_DIR+"/basic.annotation.bed"

##########
# Star  #
##########

STAR_VERSION = shell("STAR --version", read=True).strip()
STAR_GENOME_DIR = GENCODE_DIR+"/"+config["GENCODE"]["GENOME"]+".star_index/"+STAR_VERSION


############
# Include  #
############

if os.path.exists("Snakefile_versioned.sk"):
    include: "Snakefile_versioned.sk"

include: "../../local/rules/generic_rules.smk"
include: "../../local/rules/trim.smk"
include: "../../local/rules/star_alignment.smk"
include: "../../local/rules/bwa_alignment.smk"
include: "../../local/rules/count.smk"
include: "../../local/rules/rseqc.smk"
include: "../../local/rules/DGE.smk"
include: "../../local/rules/venn_heatmap.smk"
include: "../../local/rules/metagenome.smk"
include: "../../local/rules/Isoforms.smk"
include: "../../local/rules/reference.smk"
  
###############
# Ruleorder  #
###############

if config["LAYOUT"] == "SINGLE":
    ruleorder: fastp_se > fastp_pe
    ruleorder: trim_galore_se > trim_galore_pe
    ruleorder: star_align_se > star_align_pe
elif config["LAYOUT"] == "PAIRED":
    ruleorder: fastp_pe > fastp_se
    ruleorder: trim_galore_pe > trim_galore_se
    ruleorder: star_align_pe > star_align_se
    
ruleorder: featurecounts > split_bam_ribo

##############
# Rules ALL  #
##############
# TODO: add all rules all for the individual rules

rule all:
    input: 
        "GEP.count.exp_filter.ltmm.gz.xlsx",
        "multiqc_report.html",
        "multiqc_report.rseqc.html",
        "usable_reads.txt.xlsx" 

rule all_fastq_trimmed_se:
    input:
        expand("fastp/{sample}_R1.fastq.gz",
               sample=SAMPLES)

rule ALL_infer_experiment:
    input: 
        expand("rseqc/{samples}.infer_experiment.txt", samples= SAMPLES)
    output: 
        "ALL_infer_experiment"
    shell: r"""  
        matrix_reduce 'rseqc/*.infer_experiment.txt' -l '{input}' | grep . | perl -lne 'if(m/^>/){{print; next}} print "$1\t$2" if m/("[^:]+|failed to determine):\s+(.*)/' | fasta2tab | tab2matrix -r sample > {output}
    """ 

rule ALL_star:
    input:
        expand("star/{sample}.bam", sample=SAMPLES)


rule all_fastq_unmapped:
    input:
        expand("fastq_unmapped/{sample}_R1.fastq.gz", sample=SAMPLES),
        expand("fastq_unmapped/{sample}_R2.fastq.gz", sample=SAMPLES)
