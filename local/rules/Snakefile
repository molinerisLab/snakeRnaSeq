container: "/home/aleone/snakeRnaSeq/local/container/transcript_analysis.sif"   
configfile: "config.yaml"
if os.path.exists("Snakefile_versioned.sk"):
    include: "Snakefile_versioned.sk"


############
# Include  #
############

if os.path.exists("Snakefile_versioned.sk"):
    include: "Snakefile_versioned.sk"

include : "../../local/config/config_v1.sk" 
include: "../../local/rules/alignment_post.smk" 
include: "../../local/rules/utils.smk" 
